[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "analytics-dashboard-v1",
      "catalogId": "https://a2ui.org/specification/v0_9/basic_catalog.json"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "analytics-dashboard-v1",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "justify": "start",
          "align": "stretch",
          "children": ["header", "status-row", "metrics-row", "details-card"]
        },
        {
          "id": "header",
          "component": "Text",
          "variant": "h2",
          "text": "System Analytics Dashboard"
        },
        {
          "id": "status-row",
          "component": "Row",
          "children": ["status-icon", "status-label"]
        },
        {
          "id": "status-icon",
          "component": "Icon",
          "name": "check"
        },
        {
          "id": "status-label",
          "component": "Text",
          "variant": "body",
          "text": "Live: All Systems Healthy"
        },
        {
          "id": "metrics-row",
          "component": "Row",
          "children": ["cpu-card", "mem-card", "latency-card"]
        },
        {
          "id": "cpu-card",
          "component": "Card",
          "child": "cpu-content"
        },
        {
          "id": "cpu-content",
          "component": "Column",
          "children": ["cpu-title", "cpu-value"]
        },
        {
          "id": "cpu-title",
          "component": "Text",
          "variant": "caption",
          "text": "CPU Utilization"
        },
        {
          "id": "cpu-value",
          "component": "Text",
          "variant": "h3",
          "text": "42.8%"
        },
        {
          "id": "mem-card",
          "component": "Card",
          "child": "mem-content"
        },
        {
          "id": "mem-content",
          "component": "Column",
          "children": ["mem-title", "mem-value"]
        },
        {
          "id": "mem-title",
          "component": "Text",
          "variant": "caption",
          "text": "Memory Usage"
        },
        {
          "id": "mem-value",
          "component": "Text",
          "variant": "h3",
          "text": "68.2%"
        },
        {
          "id": "latency-card",
          "component": "Card",
          "child": "latency-content"
        },
        {
          "id": "latency-content",
          "component": "Column",
          "children": ["latency-title", "latency-value"]
        },
        {
          "id": "latency-title",
          "component": "Text",
          "variant": "caption",
          "text": "Avg Latency"
        },
        {
          "id": "latency-value",
          "component": "Text",
          "variant": "h3",
          "text": "124 ms"
        },
        {
          "id": "details-card",
          "component": "Card",
          "child": "details-content"
        },
        {
          "id": "details-content",
          "component": "Column",
          "children": ["details-title", "details-body"]
        },
        {
          "id": "details-title",
          "component": "Text",
          "variant": "h4",
          "text": "Resource Summary"
        },
        {
          "id": "details-body",
          "component": "Text",
          "variant": "body",
          "text": "All cloud services are operating within normal parameters. CPU usage is moderate at 42.8%, memory is at a healthy 68.2%, and average API latency is well below the 200ms SLA threshold."
        }
      ]
    }
  }
]
